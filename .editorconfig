root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{json,yml,yaml,py,sh}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# 历史迁移由摘要校验，不自动调整已有文件。
[server/internal/database/migrations/*.sql]
insert_final_newline = unset
trim_trailing_whitespace = unset
