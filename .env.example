# 复制为 .env；不提交个人配置。make env 只在文件不存在时创建。
# 优先级：显式命令行参数 > 系统环境变量 > 本文件 > 程序默认值。
# make run / server/run.sh 从仓库根启动，下列相对路径均相对仓库根。
# 仅解析 KEY=VALUE，支持成对引号，不执行 shell，不展开变量。
MERCD_ADDR=127.0.0.1:18091
MERCD_SERVER_HOST=127.0.0.1:18091
MERCD_ASSETS=server/assets/cn350
MERCD_CARDS=server/assets/shared/cards
MERCD_STATE=state/cn35
MERCD_REMOTE_ASSETS=inputs/files
MERCD_REMOTE_ASSETS_SCAN=30s
MERCD_BUNDLES=
# 默认关闭请求和事件记录；需要时设为 state/cn35/ 下的本地文件。
MERCD_REQUEST_LOG=
MERCD_EVENT_LOG=
MERCD_VERBOSE=false
# 默认不启用重建外皮测试表。
MERCD_HARDNESS_PROFILE=
